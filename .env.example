# Burnout Tracker environment variables.
# Copy this file to .env.local and fill in the values for local development.

# ---- Supabase ----------------------------------------------------------------
# Found in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only key for privileged operations (account deletion, exports, etc.)
# NEVER expose this to the browser. Optional — only required for the export
# and account-delete flows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Application -------------------------------------------------------------
# The URL the OAuth flow returns to. Use http://localhost:3000 locally and
# your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Claude API (optional, for richer weekly insights) -----------------------
# When set, /api/insights uses Claude to generate a personalised weekly
# summary with prompt caching. When unset, a rule-based fallback is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
