{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Read",
      "Edit",
      "Write",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__list_tables",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__list_migrations",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__list_extensions",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__search_docs",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__generate_typescript_types",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__get_advisors",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__get_logs",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__get_project_url",
      "mcp__b2449ac6-3b63-4041-9d5e-3852bace5737__get_publishable_keys"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
